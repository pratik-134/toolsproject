datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  USER
  ADMIN
}

model User {
  id            String       @id @default(cuid())
  name          String?
  email         String?      @unique
  emailVerified DateTime?
  image         String?
  passwordHash  String?
  role          Role         @default(USER)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  accounts      Account[]
  sessions      Session[]
  resumes       Resume[]
  aiKeys        AiKey[]

  @@map("users")
}

model Account {
  id                String  @id @default(cuid())
  userId            String  @map("user_id")
  type              String
  provider          String
  providerAccountId String  @map("provider_account_id")
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique @map("session_token")
  userId       String   @map("user_id")
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

model Resume {
  id           String           @id @default(cuid())
  userId       String?          @map("user_id")
  title        String           @default("Untitled Resume")
  slug         String?          @unique
  data         Json             // Full ResumeData json structure
  isPublic     Boolean          @default(false)
  passwordHash String?          // For password-protected shareable links
  expiresAt    DateTime?        // Optional expiration date for shared links
  targetRole   String?          // For job tailoring tracker
  applicationStatus String?     // "Applied" | "Interviewing" | "Offer" | "Rejected"
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  user         User?            @relation(fields: [userId], references: [id], onDelete: Cascade)
  versions     ResumeVersion[]
  analytics    ShareAnalytics?

  @@index([userId])
  @@index([slug])
  @@map("resumes")
}

model ResumeVersion {
  id            String   @id @default(cuid())
  resumeId      String   @map("resume_id")
  versionNumber Int      @map("version_number")
  title         String?
  data          Json
  createdAt     DateTime @default(now())

  resume        Resume   @relation(fields: [resumeId], references: [id], onDelete: Cascade)

  @@unique([resumeId, versionNumber])
  @@index([resumeId])
  @@map("resume_versions")
}

model AiKey {
  id           String   @id @default(cuid())
  userId       String   @map("user_id")
  provider     String   // "openai" | "anthropic" | "gemini" | "ollama"
  encryptedKey String   @db.Text
  iv           String   // Initialization vector (hex/base64)
  tag          String   // Auth tag for AES-256-GCM
  baseUrl      String?  // Custom endpoint for Ollama or private proxies
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, provider])
  @@map("ai_keys")
}

model ShareAnalytics {
  id           String    @id @default(cuid())
  resumeId     String    @unique @map("resume_id")
  viewCount    Int       @default(0) @map("view_count")
  lastViewedAt DateTime? @map("last_viewed_at")

  resume       Resume    @relation(fields: [resumeId], references: [id], onDelete: Cascade)

  @@map("share_analytics")
}
