# Database (Docker Postgres for local development)
DATABASE_URL="postgresql://resumebuilderlab_user:resumebuilderlab_password@localhost:5432/resumebuilderlab_db?schema=public"

# Redis (Docker Redis for local caching and rate-limiting)
REDIS_URL="redis://localhost:6379"

# NextAuth / Session Configuration
# NEXTAUTH_SECRET is also used as the JWT signing secret for the admin session.
# Generate a strong random value: openssl rand -base64 32
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="super-secret-nextauth-key-change-in-production-min32chars"

# Admin User Seed (used by: npm run seed:admin)
# Run ONCE to create the admin account. Keep these out of version control.
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="change-me-minimum-12-chars"

# Encryption Key for User-Supplied AI Keys (32-byte hex for AES-256-GCM)
# Generate via: openssl rand -hex 32
AI_ENCRYPTION_KEY="0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"

# Public App URL & Canonical Site URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_SITE_URL="https://resumebuilderlab.com"

# Optional Cloudflare R2 / S3 storage for photo uploads
# R2_ACCOUNT_ID=""
# R2_ACCESS_KEY_ID=""
# R2_SECRET_ACCESS_KEY=""
# R2_BUCKET_NAME=""
# R2_PUBLIC_URL=""

# Optional OAuth Providers
# GOOGLE_CLIENT_ID=""
# GOOGLE_CLIENT_SECRET=""
# LINKEDIN_CLIENT_ID=""
# LINKEDIN_CLIENT_SECRET=""
